datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  color         String
  sortOrder     Int               @default(0)
  subcategories Subcategory[]
  keywords      CategoryKeyword[]
  transactions  Transaction[]
  learnedRules  LearnedRule[]
}

model Subcategory {
  id           Int               @id @default(autoincrement())
  name         String
  color        String
  sortOrder    Int               @default(0)
  categoryId   Int
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  keywords     CategoryKeyword[]
  transactions Transaction[]
  learnedRules LearnedRule[]

  @@unique([categoryId, name])
}

/// Exactly one of categoryId / subcategoryId must be set (enforced in app code).
model CategoryKeyword {
  id            Int          @id @default(autoincrement())
  keyword       String
  categoryId    Int?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId Int?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
}

enum CategorySource {
  manual
  learned
  keyword
  none
}

/// User-taught fragment → category (Slice 3 Thick “merken”).
model LearnedRule {
  id                  Int         @id @default(autoincrement())
  descriptionFragment String      @unique
  categoryId          Int
  subcategoryId       Int
  category            Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory         Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  confidence          Float       @default(1)
  usageCount          Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

enum RelatedType {
  paypal_bank
  transfer
  near_duplicate
}

model Transaction {
  id                   Int             @id @default(autoincrement())
  datum                DateTime        @db.Date
  betrag               Decimal         @db.Decimal(12, 2)
  sender               String          @default("")
  empfaenger           String          @default("")
  verwendungszweck     String          @default("")
  iban                 String          @default("")
  kundenreferenz       String          @default("")
  bank                 String
  konto                String
  balance              Decimal?        @db.Decimal(12, 2)
  categoryId           Int?
  subcategoryId        Int?
  category             Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory          Subcategory?    @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  confidenceScore      Float           @default(0)
  categorySource       CategorySource  @default(none)
  /// Bidirectional partner id (both legs set on confirm).
  relatedTransactionId Int?
  relatedType          RelatedType?
  /// Synthetic / calibration plumbing — excluded from Analyse by default.
  isBalanceAdjustment  Boolean         @default(false)
  /// Confirmed investment (ETF buy etc.) — EK in Investiert; excluded from flow totals.
  isInvestment         Boolean         @default(false)
  createdAt            DateTime        @default(now())

  @@unique([bank, konto, datum, betrag, verwendungszweck, iban, kundenreferenz], name: "Transaction_dedup_key")
  @@index([datum(sort: Desc)])
  @@index([relatedTransactionId])
  @@index([bank, konto, datum])
  @@index([isInvestment])
}

/// Undirected rejected suggestion pair (txIdLow < txIdHigh).
model RelatedRejection {
  id        Int      @id @default(autoincrement())
  txIdLow   Int
  txIdHigh  Int
  createdAt DateTime @default(now())

  @@unique([txIdLow, txIdHigh])
}

/// User-configured keywords that flag investment candidates (confirm required).
model InvestmentKeyword {
  id        Int      @id @default(autoincrement())
  keyword   String   @unique
  createdAt DateTime @default(now())
}

/// Rejected investment suggestion (tx will not be re-suggested).
model InvestmentRejection {
  id            Int      @id @default(autoincrement())
  transactionId Int      @unique
  createdAt     DateTime @default(now())
}

model Account {
  id              Int       @id @default(autoincrement())
  bank            String
  konto           String
  accountIban     String    @default("")
  /// Badge color; empty → bank default from code (design.md).
  color           String    @default("")
  /// Null until the user calibrates (header uses only calibrated balances).
  currentBalance  Decimal?  @db.Decimal(12, 2)
  asOfDate        DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([bank, konto])
}
